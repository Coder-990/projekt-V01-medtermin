<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- TODO(sec): ovisnosti: Dependency-Check: 83 nalaza za provjeru; vidi alati/prije/ovisnosti-todo.md. -->
    <!-- TODO(sec): ovisnosti: OSV: 60 nalaza za provjeru; vidi alati/prije/osv-java.txt. -->
    <!-- TODO(sec): ovisnosti: Trivy: 60 nalaza za provjeru; vidi alati/prije/trivy-java.txt. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- TODO(sec): dependency-review: prijedlog Boot 4.1.2 (stabilna verzija provjerena 2026-11-13),
             bez primjene. Uskladiti startere, Jackson i testove prema migracijskim uputama;
             vidi alati/prije/prijedlog-nadogradnje.md. -->
        <version>3.5.7</version>
        <relativePath/>
    </parent>

    <groupId>hr.span.akademija</groupId>
    <artifactId>medtermin</artifactId>
    <version>1.0.0</version>
    <name>MedTermin</name>
    <description>Naručivanje pregleda, pregled nalaza i ispis potvrda za privatnu polikliniku</description>

    <properties>
        <java.version>21</java.version>
        <jacoco.version>0.8.13</jacoco.version>
        <!-- TODO(sec): dependency-review: OSV/Trivy/Dependency-Check CVE-2022-1471;
             ovaj override zadrzava SnakeYAML 1.33 i nakon promjene Boot parenta.
             Predloziti uklanjanje overridea i sigurnu obradu YAML-a; zasad ne mijenjati. -->
        <snakeyaml.version>1.33</snakeyaml.version>
    </properties>

    <dependencies>
        <!-- OSV/Trivy/Dependency-Check: Spring MVC, Tomcat, Jackson i logging dolaze tranzitivno;
             njihove verzije uskladjuje Boot parent, bez zasebnih overridea pojedinacnih JAR-ova. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Samo kriptografski dio Spring Securityja, bez web filtera. -->
        <!-- TODO(sec): dependency-review: Dependency-Check/CVE-2018-1258 provjeriti prema stvarnom modulu/verziji; LozinkaHasher trenutačno ne koristi spring-security-crypto. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- Čitanje korisničkih postavki u YAML formatu. -->
        <!-- TODO(sec): dependency-review: SnakeYAML/CVE-2022-1471 iz sva tri SCA izvjestaja povezan je s PostavkeController.spremi; vidi override i TODO uz load. -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <!-- TODO(sec): dependency-review: Dependency-Check/CVE-2026-24400; AssertJ 3.27.6 dolazi testnim starterom. Predloziti 3.27.7 ili uskladeni Boot BOM, bez primjene. -->
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>4.8.6.6</version>
                <dependencies>
                    <dependency>
                        <groupId>com.h3xstream.findsecbugs</groupId>
                        <artifactId>findsecbugs-plugin</artifactId>
                        <version>1.13.0</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Odabir testova po oznakama: ./mvnw test -Dgroups=funkcionalno
                         Bez -Dgroups pokreću se svi testovi. -->
                    <trimStackTrace>false</trimStackTrace>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Statička analiza: SpotBugs + Find Security Bugs.
             Ne pokreće se u zadanom buildu: ./mvnw -Psast compile spotbugs:check (ili spotbugs:gui) -->
        <profile>
            <id>sast</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs-maven-plugin</artifactId>
                        <version>4.8.6.6</version>
                        <configuration>
                            <effort>Max</effort>
                            <threshold>Low</threshold>
                            <plugins>
                                <plugin>
                                    <groupId>com.h3xstream.findsecbugs</groupId>
                                    <artifactId>findsecbugs-plugin</artifactId>
                                    <version>1.13.0</version>
                                </plugin>
                            </plugins>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Popis ovisnosti (SBOM, CycloneDX) za OSV-Scanner ili Trivy.
             Ne pokreće se u zadanom buildu: ./mvnw -Psca cyclonedx:makeAggregateBom (target/bom.json) -->
        <profile>
            <id>sca</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.cyclonedx</groupId>
                        <artifactId>cyclonedx-maven-plugin</artifactId>
                        <version>2.9.1</version>
                        <!-- TODO(sec): dependency-review: SBOM ne ukljucuje testne ovisnosti koje DC skenira;
                             predloziti includeTestScope=true za usporediv obuhvat, zasad bez promjene konfiguracije. -->
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
